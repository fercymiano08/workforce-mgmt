# Copy this file to ".env" (same folder) and fill in the values. ".env" is git-ignored.
# Generate secrets with:  openssl rand -hex 24      (APP_KEY:  openssl rand -base64 32)
POSTGRES_PASSWORD=change-me
SERVICE_TOKEN=change-me-shared-service-secret
APP_KEY=base64:change-me-32-bytes-base64
# Optional. Leave empty to use the rule-based AI fallback / log emails instead of sending.
GEMINI_API_KEY=
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
