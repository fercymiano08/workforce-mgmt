APP_NAME="WorkForce Pro"
APP_ENV=local
APP_KEY=base64:<generate-a-key-with: php artisan key:generate>
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=workforce_mgnt
DB_USERNAME=postgres
DB_PASSWORD=<your-database-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Which mailer to use: smtp, brevo, log (log = print to the log, never send).
#
# brevo  -> MAIL_MAILER=brevo, then set BREVO_USERNAME and BREVO_PASSWORD to your Brevo SMTP key.
# smtp   -> MAIL_MAILER=smtp with the host/port below (Gmail: smtp.gmail.com:587 over TLS).
#
# The two mailers deliberately read different host variables (BREVO_HOST vs MAIL_HOST). Selecting one
# does not borrow the other's settings, so switching providers cannot leave you dialling the old
# server with the new one's credentials.
MAIL_MAILER=brevo
MAIL_SCHEME=tls
MAIL_TIMEOUT=8

# Used only by MAIL_MAILER=smtp.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Used only by MAIL_MAILER=brevo. The SMTP key from Brevo's SMTP & API > SMTP keys page; it is the
# same string in both fields. Leave MAIL_HOST/MAIL_PORT as they are if you are not using them.
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USERNAME=<your-brevo-smtp-key>
BREVO_PASSWORD=<your-brevo-smtp-key>

# Set this on a container platform (Render, Docker). The default writes logs to a file inside the
# container, where the platform cannot show them - so swallowed errors like a failed mail send
# happen with nothing visible anywhere. This sends them to the platform's log stream instead.
LOG_CHANNEL=stderr

# WHO the mail appears to come from. This is the setting that decides whether Gmail shows a message
# in the inbox or discards it - not the mailer above.
#
# It must be a real address that your mail provider has verified as a sender (Brevo: Senders &
# Domains, shown as verified). Set it to that address.
#
# Do NOT set it to an SMTP login key. Brevo's username is a key like xsmtp-relay.brevo.com-a1b2c3,
# which is not an email address and would produce a From header no mail server can accept.
#
# Do NOT set it to a domain you do not control. A relay forwards any From you give it unchanged,
# so a From like no-reply@someotherdomain.com reaches Gmail, fails its SPF/DKIM/DMARC checks, and
# is discarded - while the relay's dashboard still reports a successful send. If MAIL_FROM_ADDRESS
# is left unset it falls back to MAIL_USERNAME, but only when that is itself a valid email address.
MAIL_FROM_ADDRESS=<your-verified-sender-email>
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set to true to seed the rich demo dataset; false keeps all tables empty
# except the fixed Workforce Admin login account.
SEED_DEMO_DATA=true

# Google Gemini API (free tier) powers the AI Decision Support module.
# Get a key at https://aistudio.google.com (no credit card required).
# If empty or unreachable, the module gracefully falls back to rule-based logic.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=15
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview

# How long a two-factor sign-in code stays usable, in seconds. The code is replaced the
# moment it is verified, so this is the window for a mistyped code - not a window in
# which an old code keeps working. Floor is 60s; below that the code expires mid-typing.
AUTH_TWO_FACTOR_TTL=180

# How long a password-reset code stays usable, in seconds. Requesting a new code replaces the
# previous one, so this is the window for reading the email and typing six digits - not a window in
# which several codes keep working. The browser countdown is driven by this value via the API
# response, so the two can never disagree. Floor is 60s.
AUTH_PASSWORD_RESET_CODE_TTL=300
