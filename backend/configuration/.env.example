APP_NAME="WorkForce Pro"
APP_ENV=local
APP_KEY=base64:<generate-a-key-with: php artisan key:generate>
APP_DEBUG=true
APP_URL=http://127.0.0.1:8008
FRONTEND_URL=http://localhost:5173

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=workforce_configuration
DB_USERNAME=postgres
DB_PASSWORD=<your-database-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=array

# Cross-service integration (see config/svc.php)
SERVICE_TOKEN=wfp-intel-2026-secret-9f3a7c1e
SVC_AUTH_MODE=remote
SVC_NOTIFICATIONS_MODE=remote
AUTH_SERVICE_URL=http://127.0.0.1:8000
COMMS_SERVICE_URL=http://127.0.0.1:8007
SVC_DEPENDENCIES=[]
