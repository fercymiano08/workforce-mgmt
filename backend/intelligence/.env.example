APP_NAME="WorkForce Pro Intelligence Service"
APP_ENV=local
APP_KEY=base64:<generate-a-key-with: php artisan key:generate>
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=workforce_intel
DB_USERNAME=postgres
DB_PASSWORD=<your-database-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@workforcepro.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cross-service wiring ------------------------------------------------
# Authentication proxy: the Auth service (core) is asked who owns a bearer
# token. SVC_AUTH_MODE=local is used by the test suite only.
AUTH_SERVICE_URL=http://127.0.0.1:8000
SVC_AUTH_MODE=remote

# Owner services this service pulls its snapshot from, plus the ones its
# AI actions write back to. Each writes to its OWN database; this service
# only ever reads, never shares an owner's tables.
CORE_SERVICE_URL=http://127.0.0.1:8000
ATTENDANCE_SERVICE_URL=http://127.0.0.1:8003
SCHEDULING_SERVICE_URL=http://127.0.0.1:8004
TIMEOFF_SERVICE_URL=http://127.0.0.1:8005
PAYROLL_SERVICE_URL=http://127.0.0.1:8006
COMMS_SERVICE_URL=http://127.0.0.1:8007
CONFIG_SERVICE_URL=http://127.0.0.1:8008

# Snapshot pull list: every owner + the tables this service mirrors locally.
# Local replica tables are refreshed over HTTP before analytics/AI reads.
SVC_DEPENDENCIES='[{"url":"http://127.0.0.1:8000","tables":["employees"]},{"url":"http://127.0.0.1:8003","tables":["attendance","security_events"]},{"url":"http://127.0.0.1:8005","tables":["leaves","overtime_requests"]},{"url":"http://127.0.0.1:8004","tables":["shift_definitions","shift_schedules"]},{"url":"http://127.0.0.1:8006","tables":["timesheets"]},{"url":"http://127.0.0.1:8008","tables":["settings"]}]'

# Write-back modes (all 'remote' in production; the test suite flips these
# to 'local' so it stays standalone and deterministic).
SVC_NOTIFICATIONS_MODE=remote
SVC_TIMEOFF_MODE=remote
SVC_ATTENDANCE_MODE=remote
SVC_CONFIGURATION_MODE=remote

# Shared secret used for machine-to-machine calls to owners' internal
# endpoints. Must match SERVICE_TOKEN in every other service's .env.
SERVICE_TOKEN=wfp-intel-2026-secret-9f3a7c1e

# Google Gemini API (free tier) powers the AI Decision Support module.
# The AI engine lives inside this service, not the core.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=15
