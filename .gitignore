# Runtime output from start-all.ps1 / stop-all.ps1 - not source, regenerated on every boot.
/logs/
*.log

# OS junk
.DS_Store
Thumbs.db

# Editor
/.vscode/
/.idea/

# Capstone document contains teammates personal CV data - never commit
*.docx

# Docker Compose secrets (copy .env.docker.example to .env)
/.env

# Raw database dumps - real employee data (names, emails, addresses, face data), never commit
/db-backups/

# Word/OneDrive temp and lock files
~WRL*.tmp
~$*
*.tmp
frontend/scripts/smoke-output/
